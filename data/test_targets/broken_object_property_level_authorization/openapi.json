{
  "openapi": "3.0.0",
  "info": {"title": "BOPLA twin apps - Users API", "version": "1.0.0"},
  "components": {
    "schemas": {
      "User": {
        "type": "object",
        "properties": {
          "id": {"type": "string"},
          "name": {"type": "string"},
          "email": {"type": "string"}
        }
      }
    }
  },
  "paths": {
    "/api/users/{id}": {
      "get": {
        "summary": "Profilo dell'utente",
        "responses": {
          "200": {"description": "Profilo", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/User"}}}}
        }
      },
      "put": {
        "summary": "Aggiorna il profilo dell'utente",
        "requestBody": {"content": {"application/json": {"schema": {"$ref": "#/components/schemas/User"}}}},
        "responses": {"200": {"description": "Profilo aggiornato"}}
      }
    }
  }
}
